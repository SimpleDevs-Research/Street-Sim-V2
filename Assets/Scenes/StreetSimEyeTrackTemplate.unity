            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    instruction: Please rotate your head to the left the furthest possible without
      rotating your body. Press "B" once you're done.
    activateObjects: []
    deactivateObjects: []
  - stepName: 
    stepEvent:
      m_PersistentCalls:
